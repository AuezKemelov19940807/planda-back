enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id             String          @id @default(uuid())
  financeSpaceId String
  type           TransactionType

  amount Decimal @db.Decimal(15, 2)

  categoryId  String
  categoryRef Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comment     String?
  date        DateTime @default(now())

  financeSpace FinanceSpace @relation(fields: [financeSpaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financeSpaceId, date])
  @@index([financeSpaceId, type])
  @@index([categoryId])
}
